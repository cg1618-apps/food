# Shell scripts are LF everywhere, whatever core.autocrlf says locally.
#
# Two things run them and both break on a CR: the box, where a shebang
# ending "bash\r" fails with "bad interpreter", and the Windows test suite,
# which executes deploy/migrations through Git Bash. Without this a fresh
# clone on a machine with autocrlf=true checks them out with CRLF and the
# failure names the interpreter rather than the line endings.
*.sh text eol=lf
deploy/migrations text eol=lf
deploy/gated-paths text eol=lf

# Batch files are CRLF everywhere, for the mirror of the reason above. cmd.exe
# tolerates LF in a file this small, but misparses labels and multi-line blocks
# in one that grows - and the committed blob is LF whatever the working tree
# looks like, so a machine with core.autocrlf=false checks it out that way.
*.cmd text eol=crlf
